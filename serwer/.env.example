# Zello Bot — konfiguracja. Skopiuj do .env i uzupełnij.
# NIGDY nie umieszczaj prawdziwego .env w repozytorium.
#
# Zapytanie o zamówienia edytujesz w osobnym pliku: query.sql (nie w kodzie!).

# --- MSSQL ---
# Instancja nazwana (bez portu!): 192.168.24.22
# Zwykły adres:                   192.168.24.22  (+ MSSQL_PORT=1433)
MSSQL_SERVER=192.168.1.10
MSSQL_PORT=1433
MSSQL_DATABASE=ERP
MSSQL_USERNAME=zello_bot
MSSQL_PASSWORD=HASLO
# Stary serwer bez TLS 1.2 → ustaw MSSQL_ENCRYPT=no
MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERTIFICATE=yes

# --- ntfy (publiczne ntfy.sh albo własny serwer na Linuxie) ------------------
# Każde urządzenie konfiguruje własny topic równy loginowi MSSQL w aplikacji Nakładka.
NTFY_SERVER=http://192.168.24.90:8093
# Token Bearer jest wymagany, jeśli self-hosted ntfy ma włączoną autoryzację.
NTFY_TOKEN=
NTFY_TAGS=package
SUPERVISOR_TOPIC=supervisor
RESPONSE_TOPIC=order-responses
# Używane wyłącznie przez `python main.py --test-users`; oddzielone od produkcji.
TEST_SUPERVISOR_TOPIC=test-supervisor
TEST_RESPONSE_TOPIC=test-responses
# Opcjonalnie ustaw osobny topic dla testów; domyślnie używany jest SUPERVISOR_TOPIC.
USERS_FILE=users.txt
STATE_FILE=state.db

# --- Zachowanie ---
POLL_INTERVAL=10

# Co ile sekund powtarzać powiadomienie (tekst+głos) na WŁASNYM zegarze, dopóki
# query.sql zwraca zamówienie — niezależnie od POLL_INTERVAL. Pierwszy anons
# leci od razu po wykryciu. 0 = wysyłaj raz po każdym sprawdzeniu bazy (co poll,
# bez powtórek między nimi). Ustaw np. 30-60, by nie spamować.
ANNOUNCE_INTERVAL=16

# ntfy obsługuje w tej wersji powiadomienia tekstowe.
SEND_TEXT=true
COURIER_ID=13
